# Copy to .env and adjust. The pipeline reads these at runtime.
# ---------------------------------------------------------------------------

# WAREHOUSE_URL controls where ingestion + AI enrichment write.
# Local dev (default if unset) -> a DuckDB file in the repo:
#   WAREHOUSE_URL=duckdb:///warehouse.duckdb
# Deployed via docker-compose -> Postgres:
WAREHOUSE_URL=postgresql+psycopg2://energy:energy@localhost:5432/energy

# dbt Postgres target reads these (see dbt/profiles.yml):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
POSTGRES_DB=energy

# AI enrichment backend: local | hf | claude | template
AI_BACKEND=local
# LOCAL_MODEL=google/flan-t5-base    # or flan-t5-small (lighter) / flan-t5-large (nicer)
# HF_TOKEN=hf_xxx                    # only for AI_BACKEND=hf
# ANTHROPIC_API_KEY=sk-ant-xxx      # only for AI_BACKEND=claude
